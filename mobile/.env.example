EXPO_PUBLIC_API_BASE_URL=http://localhost:8000
# Optional, dev-only and opt-in: force a fixed GPS position instead of asking the OS.
# Set this only when you also enable EXPO_PUBLIC_ALLOW_DEV_LOCATION_OVERRIDE=true.
# Compiled out of release builds via __DEV__ (see src/services/locationService.ts).
# EXPO_PUBLIC_ALLOW_DEV_LOCATION_OVERRIDE=true
# EXPO_PUBLIC_DEV_LOCATION=33.5731,-7.5898
